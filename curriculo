<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thaylane Paulo | Links</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #ff9a9e, #fad0c4, #fbc2eb);
      overflow: hidden;
    }

    .card {
      width: 90%;
      max-width: 420px;
      padding: 35px;
      border-radius: 28px;
      text-align: center;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(12px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      animation: fadeIn 1s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .profile-img {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid white;
      margin-bottom: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    h1 {
      font-size: 2rem;
      color: #ffffff;
      margin-bottom: 10px;
    }

    p {
      color: #fff;
      margin-bottom: 28px;
      font-size: 1rem;
      opacity: 0.9;
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .btn {
      text-decoration: none;
      padding: 15px;
      border-radius: 16px;
      background: white;
      color: #d63384;
      font-weight: bold;
      font-size: 1rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(255,255,255,0.3);
    }

    .btn:hover {
      transform: scale(1.05);
      background: #d63384;
      color: white;
    }

    .footer {
      margin-top: 25px;
      color: white;
      font-size: 0.85rem;
      opacity: 0.8;
    }
  </style>
</head>

<body>

  <div class="card">

    <img
      class="profile-img"
      src="https://share.icloud.com/photos/001kpissrC1h0knsRTHdrnrWQ"
      alt="Foto de Thaylane Paulo"
    />

    <h1>Thaylane Paulo</h1>

    <p>
      Currículo Profissional • Portfólio • Redes Sociais
    </p>

    <div class="links">

      <a
        class="btn"
        href="https://pin.it/6nasS6X6b"
        target="_blank"
      >
        Pinterest
      </a>

      <a
        class="btn"
        href="https://www.linkedin.com/in/thaylane-pauo-do-nascimento-9a0b1525a?"
        target="_blank"
      >
        LinkedIn
      </a>

      <a
        class="btn"
        href="https://www.instagram.com/thaylanepaulo/"
        target="_blank"
      >
        Instagram
      </a>

    </div>

    <div class="footer">
      © 2026 Thaylane Paulo
    </div>

  </div>

</body>
</html>
